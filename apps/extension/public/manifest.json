{
  "manifest_version": 3,
  "name": "TapStash",
  "version": "0.0.1",
  "description": "Save videos, articles, and links into categories from anywhere on the web.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "contextMenus"]
}
